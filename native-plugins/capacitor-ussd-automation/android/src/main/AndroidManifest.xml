<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CALL_PHONE: required by TelephonyManager.sendUssdRequest() and
         by dialing a USSD code via Intent.ACTION_CALL targeting a
         specific SIM's PhoneAccountHandle. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- READ_PHONE_STATE: required to enumerate active SIM subscriptions
         (SubscriptionManager) for dual-SIM detection. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application>
        <!-- The core automation engine. BIND_ACCESSIBILITY_SERVICE is
             required by the OS on any AccessibilityService declaration;
             exported=true is likewise required for the system to bind
             to it, but the permission restricts binding to the system
             itself, not to other apps. android:name is fully-qualified
             deliberately, so this resolves correctly regardless of the
             final merged app's own package name. -->
        <service
            android:name="com.agentpro.ussd.UssdAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/ussd_accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ussd_accessibility_service_config" />
        </service>
    </application>
</manifest>
